# Copy to .env; process environment values take precedence.
# Remote inference is preferred when this URL is set.
TTS_INFERENCE_URL=https://trustless-episode-blank.ngrok-free.dev
# VoxCPM2 deployment metadata; the remote host loads this model itself.
TTS_REMOTE_MODEL_ID=LyngualLabs/YorubaEnglish-CodeSwitching-TTS
# Relative asset paths resolve from backend/, independent of working directory.
TTS_DEFAULT_VOICE_AUDIO_PATH=assets/voices/naijavoice_default_voice.wav
TTS_DEFAULT_VOICE_TRANSCRIPT_PATH=assets/voices/naijavoice_default_voice.txt
# Local model paths are only used when TTS_INFERENCE_URL is empty.
TTS_CHECKPOINT_PATH=
TTS_VOCAB_PATH=
TTS_REFERENCE_AUDIO_PATH=
TTS_DEVICE=cuda
