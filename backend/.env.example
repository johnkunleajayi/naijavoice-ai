# Copy to .env; process environment values take precedence.
# Remote inference is preferred when this URL is set.
TTS_INFERENCE_URL=https://trustless-episode-blank.ngrok-free.dev
# Local model paths are only used when TTS_INFERENCE_URL is empty.
TTS_CHECKPOINT_PATH=
TTS_VOCAB_PATH=
TTS_REFERENCE_AUDIO_PATH=
TTS_DEVICE=cuda
